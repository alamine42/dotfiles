{
  "permissions": {
    "allow": [
      "# --- Git operations (universal across all projects) ---",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git init:*)",
      "Bash(git rm:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",

      "# --- Package managers (npm universal, pnpm/bun for some projects) ---",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(npm exec:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",

      "# --- Beads task management (used in 10+ projects) ---",
      "Bash(bd:*)",

      "# --- TypeScript (used in 6+ projects) ---",
      "Bash(npx tsc:*)",

      "# --- Shell utilities (common across projects) ---",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(open:*)",
      "Bash(xargs:*)",
      "Bash(bash:*)",
      "Bash(timeout:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(lsof:*)",

      "# --- Environment variables (generic, no hardcoded credentials) ---",
      "Bash(export:*)",
      "Bash(unset:*)",
      "Bash(printenv:*)",

      "# --- Docker (used in infra-heavy projects) ---",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",

      "# --- Databases (used in 4+ projects) ---",
      "Bash(psql:*)",
      "Bash(redis-cli:*)",
      "Bash(supabase:*)",

      "# --- Deployment tools (used across multiple projects) ---",
      "Bash(railway:*)",
      "Bash(vercel:*)",

      "# --- GitHub CLI (used in 3+ projects) ---",
      "Bash(gh:*)",

      "# --- Homebrew (macOS) ---",
      "Bash(brew:*)",

      "# --- Python (occasional use) ---",
      "Bash(python3:*)",

      "# --- Web access ---",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",

      "# --- Skills ---",
      "Skill(task)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff"
          }
        ]
      }
    ]
  }
}
